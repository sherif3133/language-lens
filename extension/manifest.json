{
	"manifest_version": 3,
	"name": "Language Lens – Sawa English",
	"short_name": "Language Lens",
	"version": "0.9.1",
	"description": "Learn English from YouTube and any website, on computer or phone: meanings on hover or tap, pronunciation and review cards.",
	"minimum_chrome_version": "116",
	"permissions": [
		"storage",
		"identity",
		"scripting",
		"alarms",
		"activeTab"
	],
	"host_permissions": [
		"https://www.youtube.com/*",
		"https://m.youtube.com/*",
		"https://sawaenglish.com/*"
	],
	"optional_host_permissions": [
		"https://*/*",
		"http://*/*"
	],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"https://www.youtube.com/*",
				"https://m.youtube.com/*"
			],
			"js": [
				"content/yt-main.js"
			],
			"world": "MAIN",
			"run_at": "document_start"
		},
		{
			"matches": [
				"https://www.youtube.com/*"
			],
			"js": [
				"content/vocals-main.js"
			],
			"world": "MAIN",
			"run_at": "document_start"
		},
		{
			"matches": [
				"https://www.youtube.com/*",
				"https://m.youtube.com/*"
			],
			"js": [
				"content/common.js",
				"content/feedback.js",
				"content/card.js",
				"core/explicit.js",
				"core/captions.js",
				"content/vocals.js",
				"content/music.js",
				"content/game.js",
				"content/yt.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"http://*/*",
				"https://*/*"
			],
			"exclude_matches": [
				"https://www.youtube.com/*",
				"https://m.youtube.com/*",
				"https://sawaenglish.com/*",
				"https://*.sawaenglish.com/*"
			],
			"js": [
				"content/common.js",
				"content/feedback.js",
				"content/card.js",
				"content/page.js"
			],
			"run_at": "document_idle",
			"all_frames": false
		},
		{
			"matches": [
				"http://*/*",
				"https://*/*"
			],
			"js": [
				"content/proof.js"
			],
			"run_at": "document_idle",
			"all_frames": false
		},
		{
			"matches": [
				"https://sawaenglish.com/*",
				"https://www.sawaenglish.com/*"
			],
			"js": [
				"content/connect.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://www.youtube.com/*",
				"https://m.youtube.com/*"
			],
			"js": [
				"content/yt-filter.js"
			],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_popup": "popup/popup.html",
		"default_title": "Language Lens",
		"default_icon": {
			"16": "icons/16.png",
			"32": "icons/32.png",
			"48": "icons/48.png",
			"128": "icons/128.png"
		}
	},
	"icons": {
		"16": "icons/16.png",
		"32": "icons/32.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"web_accessible_resources": [
		{
			"resources": [
				"vocals/vocals.html",
				"vocals/prepare.html"
			],
			"matches": [
				"https://www.youtube.com/*"
			]
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
	}
}
